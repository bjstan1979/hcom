FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash build-essential ca-certificates curl fd-find findutils git jq procps \
      python3 ripgrep tini util-linux xz-utils \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

ARG PI_UID=1000
ARG PI_GID=1000

RUN if ! getent group "${PI_GID}" >/dev/null; then groupadd --gid "${PI_GID}" pi; fi \
 && if ! getent passwd "${PI_UID}" >/dev/null; then useradd --uid "${PI_UID}" --gid "${PI_GID}" --home-dir /home/pi --shell /bin/bash pi; fi \
 && mkdir -p /home/pi/.pi/agent /home/pi/.cache /home/pi/.hcom-client \
 && chown -R "${PI_UID}:${PI_GID}" /home/pi

COPY rootfs/ /
RUN chmod 0755 /usr/local/bin/hcom /usr/local/bin/pi /usr/local/bin/pi-container-entry \
 && chown -R "${PI_UID}:${PI_GID}" /home/pi /opt/pi-agent-seed

ENV HOME=/home/pi \
    PI_CODING_AGENT_DIR=/home/pi/.pi/agent \
    HCOM_CLIENT_DIR=/home/pi/.hcom-client
USER ${PI_UID}:${PI_GID}
WORKDIR /home/pi
CMD ["sleep", "infinity"]
