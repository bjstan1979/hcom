#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: hcom-podman-sandbox [--workspace DIR] [hcom launch arguments...]

Launch HCOM workers in one persistent rootless Podman environment per canonical
workspace. All workspaces join the host-global HCOM realm through an authenticated
Unix-socket broker; host HCOM database and keys are never mounted into containers.

Examples:
  hcom-podman-sandbox 1 pi
  hcom-podman-sandbox --workspace /path/to/project 1 pi --tag critical

Environment:
  HCOM_PODMAN_IMAGE       OCI image (default localhost/hcom-pi-workspace:live)
  HCOM_PODMAN_STATE_ROOT  Persistent workspace state root
  HCOM_PODMAN_PAYLOAD_ROOT Versioned read-only Pi payload root
  HCOM_BROKER_ROOT        Host broker runtime root
EOF
}

workspace=$PWD
args=()
while (($#)); do
  case "$1" in
    --workspace)
      (($# >= 2)) || { printf 'hcom-podman-sandbox: --workspace requires a directory\n' >&2; exit 2; }
      workspace=$2; shift 2 ;;
    --workspace=*) workspace=${1#*=}; shift ;;
    -h|--help) usage; exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done
((${#args[@]})) || { usage >&2; exit 2; }

for command in hcom podman realpath sha256sum flock; do
  command -v "$command" >/dev/null 2>&1 || {
    printf 'hcom-podman-sandbox: required command missing: %s\n' "$command" >&2
    exit 1
  }
done
[[ -d "$workspace" ]] || { printf 'hcom-podman-sandbox: workspace is not a directory: %s\n' "$workspace" >&2; exit 1; }
workspace=$(realpath -e -- "$workspace")
home=$(realpath -e -- "$HOME")
hcom_dir=$(realpath -e -- "${HCOM_DIR:-$HOME/.hcom}")
[[ "$workspace" != / && "$workspace" != "$home" ]] || {
  printf 'hcom-podman-sandbox: refusing unsafe workspace %s\n' "$workspace" >&2; exit 1;
}
case "$hcom_dir/" in "$workspace"/*) printf 'hcom-podman-sandbox: workspace contains HCOM state\n' >&2; exit 1;; esac

podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null | grep -qx true || {
  printf 'hcom-podman-sandbox: Podman is unavailable or not rootless\n' >&2; exit 1;
}
image=${HCOM_PODMAN_IMAGE:-localhost/hcom-pi-workspace:live}
podman image exists "$image" || {
  printf 'hcom-podman-sandbox: image is missing: %s\n' "$image" >&2
  printf 'Build it from pi-framework/podman-workspace first.\n' >&2
  exit 1
}
id=$(printf '%s' "$workspace" | sha256sum | cut -c1-20)
container=hcs-$id
configured_payload_root=${HCOM_PODMAN_PAYLOAD_ROOT:-$HOME/.local/share/hcom-sandbox/payloads}
payload_root=
payload=
if podman container exists "$container"; then
  pinned=$(podman container inspect --format '{{ index .Config.Labels "io.hcom.payload-root" }}' "$container" 2>/dev/null || true)
  case "$pinned" in
    ''|'<no value>') payload='image-baked (legacy)' ;;
    *)
      payload_root=$(realpath -e -- "$configured_payload_root")
      payload=$(realpath -e -- "$pinned")
      case "$payload/" in "$payload_root/versions/"*/) ;; *)
        printf 'hcom-podman-sandbox: pinned payload escapes version root: %s\n' "$payload" >&2
        exit 1 ;;
      esac ;;
  esac
else
  image_payload_mode=$(podman image inspect --format '{{ index .Config.Labels "io.hcom.payload-mode" }}' "$image" 2>/dev/null || true)
  [[ $image_payload_mode == readonly-host-bind ]] || {
    printf 'hcom-podman-sandbox: image does not support read-only payloads: %s\n' "$image" >&2
    exit 1
  }
  [[ -L "$configured_payload_root/current" ]] || {
    printf 'hcom-podman-sandbox: current payload is missing: %s\n' "$configured_payload_root/current" >&2
    exit 1
  }
  payload_root=$(realpath -e -- "$configured_payload_root")
  payload=$(realpath -e -- "$payload_root/current")
  case "$payload/" in "$payload_root/versions/"*/) ;; *)
    printf 'hcom-podman-sandbox: current payload escapes version root: %s\n' "$payload" >&2
    exit 1 ;;
  esac
fi
broker_root=${HCOM_BROKER_ROOT:-$HOME/.local/share/hcom-sandbox/brokers/$id}
mkdir -p "$broker_root"
chmod 700 "$broker_root"
socket=$broker_root/hcom.sock
token=$broker_root/token
bridge_token=$broker_root/bridge-token
workspace_binding=$broker_root/workspace
lock=$broker_root/start.lock
broker_binary_hash=$broker_root/hcom.sha256
broker_healthy() (
  cd "$workspace"
  HCOM_BROKER_SOCKET="$socket" HCOM_BROKER_TOKEN_FILE="$token" hcom status >/dev/null 2>&1
)
exec 9>"$lock"
flock 9
for secret in "$token" "$bridge_token"; do
  if [[ ! -f "$secret" ]]; then
    umask 077
    head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$secret.tmp"
    mv "$secret.tmp" "$secret"
  fi
  chmod 600 "$secret"
done
printf '%s\n' "$workspace" > "$workspace_binding.tmp"
chmod 600 "$workspace_binding.tmp"
mv "$workspace_binding.tmp" "$workspace_binding"

unit=hcom-workspace-broker-$id.service
hcom_bin=$(realpath -e -- "$(command -v hcom)")
broker_binary_current() {
  local expected actual
  [[ -f "$broker_binary_hash" && ! -L "$broker_binary_hash" ]] || return 1
  read -r expected < "$broker_binary_hash"
  actual=$(sha256sum "$hcom_bin")
  actual=${actual%% *}
  [[ "$expected" == "$actual" ]]
}
if [[ ! -S "$socket" ]] || ! broker_healthy || ! broker_binary_current; then
  command -v systemctl >/dev/null 2>&1 && command -v systemd-run >/dev/null 2>&1 || {
    printf 'hcom-podman-sandbox: systemd user services are required for the broker\n' >&2
    exit 1
  }
  systemctl --user show-environment >/dev/null 2>&1 || {
    printf 'hcom-podman-sandbox: systemd user manager is unavailable\n' >&2
    exit 1
  }
  systemctl --user stop "$unit" >/dev/null 2>&1 || true
  systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
  rm -f "$socket"
  systemd-run --user --quiet --unit "$unit" \
    --property=Restart=on-failure --property=RestartSec=1s \
    --property="StandardOutput=append:$broker_root/broker.out" \
    --property="StandardError=append:$broker_root/broker.err" \
    "$hcom_bin" broker-serve --socket "$socket" --token-file "$token" --workspace "$workspace"
  for _ in $(seq 1 100); do
    [[ -S "$socket" ]] && broker_healthy && break
    sleep 0.05
  done
  [[ -S "$socket" ]] && broker_healthy || {
    printf 'hcom-podman-sandbox: broker failed to start; inspect: journalctl --user -u %s\n' "$unit" >&2
    exit 1
  }
  systemctl --user show "$unit" -p MainPID --value > "$broker_root/broker.pid"
  current_hcom_hash=$(sha256sum "$hcom_bin")
  current_hcom_hash=${current_hcom_hash%% *}
  printf '%s\n' "$current_hcom_hash" > "$broker_binary_hash.tmp"
  chmod 600 "$broker_binary_hash.tmp"
  mv -f "$broker_binary_hash.tmp" "$broker_binary_hash"
fi
flock -u 9

cat >&2 <<EOF
HCOM PODMAN WORKSPACE
workspace: $workspace
image:     $image
container: $container
state:     ${HCOM_PODMAN_STATE_ROOT:-$HOME/.local/share/hcom-sandbox/workspaces}/$id
payload:   $payload (read-only)
realm:     host-global HCOM via authenticated broker
host data: HCOM DB/key not mounted
rootfs:    read-only; workspace + private state writable
fallback:  disabled
EOF

export HCOM_WORKER_SANDBOX=podman-workspace
export HCOM_WORKER_SANDBOX_ROOT=$workspace
export HCOM_PODMAN_IMAGE=$image
[[ -z $payload_root ]] || export HCOM_PODMAN_PAYLOAD_ROOT=$payload_root
export HCOM_BROKER_SOCKET=$socket
export HCOM_BROKER_TOKEN_FILE=$token
export HCOM_BRIDGE_TOKEN_FILE=$bridge_token
for bridge in AGENTMEMORY ANYSEARCH MMX FLOWUS; do
  var=${bridge}_SOCKET
  default=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${bridge,,}-bridge/${bridge,,}.sock
  socket=${!var:-$default}
  if [[ -S "$socket" ]]; then export "$var=$socket"; else unset "$var"; fi
done
exec hcom "${args[@]}"
